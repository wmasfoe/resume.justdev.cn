# ============================================================
# LLM Provider 选择：dify | openai | anthropic
# 仅服务端读取，不会进客户端 bundle
# ============================================================
LLM_PROVIDER=dify

# ============================================================
# Origin 白名单（可选）
# 默认只允许同源请求。如需允许其它域名调用，逗号分隔列出。
#   ALLOWED_ORIGINS=https://x.example,https://y.example
# ============================================================
ALLOWED_ORIGINS=

# ============================================================
# Dify （当 LLM_PROVIDER=dify 时使用）
# ============================================================
DIFY_APP_ID=xxxxxx
DIFY_API_KEY=app-xxxxxxxx
DIFY_API_URL=https://api.dify.ai/v1

# ============================================================
# OpenAI（含 OpenAI 兼容协议：DeepSeek / Ollama / 通义 等）
# 当 LLM_PROVIDER=openai 时使用
# ============================================================
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ============================================================
# Anthropic 原生（Claude Messages API）
# 当 LLM_PROVIDER=anthropic 时使用
# ============================================================
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-opus-4-7
# 可选：开启 extended thinking 时设置 budget_tokens（>0 启用）
ANTHROPIC_THINKING_BUDGET=0
ANTHROPIC_MAX_TOKENS=4096
