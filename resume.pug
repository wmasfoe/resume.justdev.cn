doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(http-equiv="X-UA-Compatible", content="IE=edge")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    //- <link rel="icon" href="https://antfu.me/favicon.svg" type="image/svg+xml">
    link(rel="icon", href="https://blog.justdev.cn/static/favicons/favicon-32x32.png", type="image/png")
    title= resume.basics ? `${resume.basics.name} - Résumé` : 'Résumé'
    script(defer, src="https://code.iconify.design/1/1.0.6/iconify.min.js")
    link(href="https://cdn.bootcdn.net/ajax/libs/twitter-bootstrap/3.2.0/css/bootstrap.min.css", rel="stylesheet")
    link(href="https://fonts.googleapis.com/css?family=Noto+Sans+SC|Nunito+Sans:400,700&display=swap", rel="stylesheet")
    style.
      #{css}
    style.
      @media (prefers-color-scheme: dark) {
        html, img { 
          filter: invert(1) hue-rotate(180deg);
        }
        div, li, ul, ol, img, p {
          box-shadow: none;
        }
        *, html, body, div {
          color-scheme: dark;
        }
        html {
          background-color: #000;
        }
        .background-card h4 .title {
          filter: none;
          background-color: inherit !important;
          color: inherit !important;
          font-weight: 600;
        }
      }
    style.
      #{newStyle}

  body(itemscope itemtype="http://schema.org/Person")
    .container
      section.row
        .card-wrapper
          if resume.basics
            .card
              .profile-card
                .contact-details
                  .name-and-profession
                    h3.text-bolder.name(itemprop="name")= resume.basics.name
                    .text-muted.job.no-print(itemprop="jobTitle")= resume.basics.label
                  if resume.basics.address
                    .text-muted.info.no-print(style="font-size:0.9em", itemprop="address")= resume.basics.address

                  .detail.new-style-inline-block
                    if resume.basics.phone
                      span.info.mobile-only
                        a.link-disguise(href=`tel://${resume.basics.phone}`, itemprop="telephone", target="_blank")= resume.basics.phone
                    if resume.basics.email
                      span.info.mobile-only
                        span.no-dashed.link-disguise(itemprop="email", target="_blank") | 
                      span.info
                        a.link-disguise(href=`mailto:${resume.basics.email}`, itemprop="email", target="_blank")= resume.basics.email

                  .detail.new-style-inline-block.print-only
                    if resume.basics.status
                      span.info.mobile-only
                        span.link-disguise(itemprop="telephone", target="_blank")= resume.basics.status
                    if resume.basics.workingYears
                      span.info.mobile-only
                        span.no-dashed.link-disguise(itemprop="email", target="_blank") | 
                      span.info
                        span.link-disguise(itemprop="email", target="_blank")= resume.basics.workingYears

                  if resume.basics.location
                    .detail
                      span.info
                        | #{resume.basics.location.city}, #{resume.basics.location.region}, #{resume.basics.location.countryCode}

                .new-style-social-links
                  each profile in resume.basics.profiles
                    a.social-link.icon(href=profile.url, target="_blank")
                      span.iconify(data-icon=toSocialIcon(profile.network))

      section.row.page
        .card-wrapper
          .card.background-card
            .no-print
              h4#about
                span.title 简介
              .card-nested(itemprop="description")
                p= breaklines(resume.basics.summary)

            h4#skills
              span.title 专业技能
            ul.skills-list
              each skill in resume.skills
                li.highlight= skill

            #work-experience
              h4
                span.title 工作经历
              ul.list-unstyled.print-flex
                each work in resume.work
                  li.card-nested.relax
                    .content.has-sidebar
                      p.clear-margin-sm
                        strong
                          if work.website
                            a(href=work.website, target="_blank")= work.company
                          else
                            = work.company
                        span.text-muted(style="margin-left: 0.3em")= work.position
                      p.text-muted
                        small
                          span.space-right #{work.startDate} - 
                            if work.endDate
                              = work.endDate
                            else
                              | 至今 
                            |  | #{work.location}
                      p= work.summary
                      if work.highlights
                        ul.highlight
                          each highlight in work.highlights
                            li= highlight

            #workProject
              h4#skills
                span.title 项目经历
              ul.list-unstyled
                each project in resume.workProject
                  li.card-nested.relax(class=project.hbsClass)
                    .content.has-sidebar
                      p.clear-margin-sm
                        strong= project.projectName
                        span.text-muted(style="margin-left: 0.3em")= project.role
                      if project.workSkill
                        .work-skill-list
                          p.strong 技术栈：
                          each skill in project.workSkill
                            span(style="margin: 5px 0;")= skill
                      if project.desc
                        .work-skill-list
                          p.strong 技术实现：
                        ul.highlight
                          each description in project.desc
                            li(style="margin: 5px 0;")= description

            #work-projects-group
              if resume.projects
                #projects
                  h4
                    span.title 开源贡献
                  .card-nested(style="display: flex; flex-wrap: wrap; justify-content: flex-start;")
                    each project in resume.projects
                      .content.has-sidebar(style="width: 500px;")
                        p.clear-margin-sm
                          strong
                            a(href=project.url, target="_blank")= project.name
                          span.text-muted(style="margin-left: 0.3em")= project.description

            .no-print
              h4#publications
                span.title 成果
              .card-nested
                ul.list-unstyled
                  each publication in resume.publications
                    li
                      strong= publication.name
                      span.text-muted - #{publication.publisher}
                      p #{publication.releaseDate} | #{publication.summary}
                      p= publication.website
